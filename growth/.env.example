# Copy to growth/.env. The CLI loads that file automatically, regardless of cwd.
# Existing runner/shell variables take priority. Never commit the populated .env.
# Credential application and setup steps: scripts/credentials.md
# Enable sources and select property/app/package/report in config.local.json.

# Google: use an external ADC credential file, existing ADC, OR a bearer token.
# Keep the JSON key outside this repository. Paths may be absolute or relative
# to this .env file. Quote paths containing spaces. No $VARIABLE expansion.
GOOGLE_APPLICATION_CREDENTIALS=
GROWTH_GOOGLE_ACCESS_TOKEN=

# Apple: team API key configuration. Keep the .p8 file outside this repository.
# Nonempty values below override key_id / issuer_id in config.local.json.
GROWTH_APPLE_KEY_ID=
GROWTH_APPLE_ISSUER_ID=
GROWTH_APPLE_PRIVATE_KEY_PATH=

# Alternative to team-key signing: an externally generated short-lived JWT.
# A nonempty token takes precedence over key-based authentication.
GROWTH_APPLE_ACCESS_TOKEN=
